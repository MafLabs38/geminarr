{
  "name": "geminarr",
  "version": "0.0.0",
  "private": true,
  "description": "A satellite of Mnemarr: brings the history of a web assistant (Gemini) into its memory, in the spirit of the *arr suite",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint frontend tests/e2e extension tools/extension",
    "lint:fix": "eslint frontend tests/e2e extension tools/extension --fix",
    "stylelint": "stylelint \"frontend/**/*.css\"",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css}\" \"tests/e2e/**/*.ts\" \"extension/**/*.{js,json}\" \"tools/extension/**/*.mjs\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css}\" \"tests/e2e/**/*.ts\" \"extension/**/*.{js,json}\" \"tools/extension/**/*.mjs\"",
    "test": "vitest run --config frontend/vite.config.ts",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@microsoft/signalr": "11.0.0",
    "@tanstack/react-query": "5.108.0",
    "lucide-react": "1.74.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
