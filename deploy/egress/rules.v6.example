# The egress guard (ADR 0020), IPv6: the same, with the addresses of Mnemarr and of the name server in IPv6 if they have one (or none: then Geminarr reaches nothing over IPv6).
*filter
:OUTPUT ACCEPT [0:0]
-A OUTPUT -m owner --uid-owner 1654 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m owner --uid-owner 1654 -o lo -p tcp -m multiport --dports 9222,3000 -j ACCEPT
# -A OUTPUT -m owner --uid-owner 1654 -d <mnemarr-ipv6>/128 -p tcp --dport <mnemarr-port> -j ACCEPT
-A OUTPUT -m owner --uid-owner 1654 -p tcp -j REJECT --reject-with tcp-reset
-A OUTPUT -m owner --uid-owner 1654 -j REJECT
COMMIT
