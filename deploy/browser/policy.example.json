{
  "ExtensionSettings": {
    "<extension-id>": {
      "installation_mode": "force_installed",
      "update_url": "http://geminarr:8282/api/v1/extension/update.xml"
    }
  },
  "3rdparty": {
    "extensions": {
      "<extension-id>": {
        "geminarrUrl": "http://geminarr:8282",
        "token": "<the content of GEMINARR__EXTENSION__TOKENFILE>",
        "roundMinutes": 15
      }
    }
  },
  "PasswordManagerEnabled": false,
  "BrowserSignin": 0,
  "SyncDisabled": true
}
